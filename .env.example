# ── Oriant.ai marketing deployment ───────────────────────────────────────────
# Copy to `.env.local` for local overrides; set these in the host dashboard
# for real deployments. See docs/MARKETING_DEPLOYMENT_RUNBOOK.md.

# Deployment mode (server-side only, never NEXT_PUBLIC_).
#   unset / "marketing" → marketing-only: every product route is locked
#                          server-side and providers are force-disabled.
#   "product"           → full interactive mock (LOCAL / INTERNAL ONLY —
#                          never set this on a public deployment).
SITE_MODE=marketing

# Public origin for canonical URLs, Open Graph, robots and the sitemap.
NEXT_PUBLIC_SITE_URL=https://oriant.ai

# Guided-demo contact destination, in priority order:
# 1. Booking page (Calendly/Cal.com/etc.) — opened in a new tab if set.
NEXT_PUBLIC_DEMO_BOOKING_URL=
# 2. Contact email for the mailto fallback (defaults to hello@oriant.ai).
NEXT_PUBLIC_DEMO_CONTACT_EMAIL=
# Reserved for a future validated demo-request form (keep false).
NEXT_PUBLIC_DEMO_FORM_ENABLED=false

# Optional approved analytics identifier (leave empty to ship no analytics).
NEXT_PUBLIC_ANALYTICS_ID=

# Do NOT set product provider keys (AI&, Nosana, Doubleword, Daytona) in the
# marketing deployment. Marketing mode ignores them even if present; the
# product-mode key reference lives on branch backup/full-product-mock.
